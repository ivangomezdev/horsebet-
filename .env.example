# Copia este archivo a .env.local. Nunca compartas ni publiques sus valores.
APP_URL=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: secret key sb_secret_... (o service_role heredada).
SUPABASE_SECRET_KEY=
# Genera con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_RATE_LIMIT_SECRET=
# Activar después de configurar Google en Supabase > Authentication > Providers.
AUTH_GOOGLE_ENABLED=false
# Activar después de configurar SMTP y las plantillas de correo.
AUTH_EMAIL_ENABLED=false
# Solo desarrollo. Vacío usa el idioma como sugerencia; en Vercel se usa la IP.
DEV_COUNTRY=
# Cifrado AES-256-GCM de datos personales KYC, solo servidor. Conserva una copia segura.
# Genera con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
KYC_ENCRYPTION_KEY=
